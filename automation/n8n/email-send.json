    {
      "parameters": {
        "url": "https://rgasjotvqwkjbeivlhvn.supabase.co/rest/v1/workspace_settings?select=*&limit=1",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",

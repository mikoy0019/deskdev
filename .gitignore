# deps
node_modules/

# builds
dist/
*.tsbuildinfo

# the old standalone DeskDev folder — the code now lives in site/src/deskdev.
# All that is left is the legacy env file, read as a fallback by
# scripts/lib/env.mjs until it moves to ./.env.local. Never `git clean -x`.
web/

# expo / react-native native projects — regenerated by `expo prebuild`
.expo/
mobile/android/
mobile/ios/
*.hprof
*.orig.*

# logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# env — never commit secrets. The one secrets file is ./.env.local; the
# committed catalogues are .env.example (root, site/, mobile/, video/).
.env
.env.*
!.env.example
# Cloudflare local Worker secrets (wrangler dev, and next dev through site/next.config.ts)
.dev.vars*
!.dev.vars.example

# tooling — keep the Radon launch config, drop everything else editor-local
.vscode/*
!.vscode/launch.json
qa-out/
.wrangler/
supabase/.temp/

# os
.DS_Store
Thumbs.db

# n8n: `node scripts/n8n.mjs pull` writes the live workflows here for diffing
automation/n8n/.live/
.devswarm-temp/

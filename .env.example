# The repo's ONE secrets file is .env.local at the repo root (gitignored by
# `.env.*`). This file is its catalogue: names only, grouped by who reads them.
# Never put a value here. Never commit .env.local.
#
# How it is read: scripts/lib/env.mjs. Order, first file wins per key:
#   1. ./.env.local                  this file's real twin
#   2. ./web/.env.local              legacy: where it lived until the move
#   3. ./automation/.env.local       legacy: the old n8n-only file
# A legacy hit prints one warning line. DESKDEV_ENV_FILE=<path> (or
# N8N_ENV_FILE) replaces the chain with one file, e.g. one kept outside the repo.
# A non-empty variable already in your shell beats every file.
#
# Not in here:
#   - NEXT_PUBLIC_* build values      site/.env.local     (see site/.env.example)
#   - local Worker secrets for dev    site/.dev.vars      (see site/.env.example)
#   - EXPO_PUBLIC_*                   mobile/.env         (see mobile/.env.example)
#   - human logins (dashboard / n8n owner / DeskDev admin passwords): a password
#     manager, not a dotfile.
# Production values live in the platform that runs the code (Worker secrets,
# Supabase function secrets, Supabase Vault, n8n credentials, Render env); the
# copies below are what the repo tooling pushes or uses locally.

# ---------------------------------------------------------------------------
# Override (optional): read exactly this file instead of the chain above.
# DESKDEV_ENV_FILE=

# ---------------------------------------------------------------------------
# scripts/n8n.mjs  (push/pull/audit the [deskdev] workflows; automation/README.md)
N8N_BASE_URL=
# n8n → Settings → n8n API
N8N_API_KEY=
# Shared with: Vault 'n8n_webhook_secret', the n8n credential "DeskDev Webhook
# Secret", the vault-reset function and the keep-alive Worker.
N8N_WEBHOOK_SECRET=
# DeskDev project (rgasjotvqwkjbeivlhvn) service role: becomes the n8n
# "Supabase — DeskDev" credential. Never in a client, never on the site Worker.
SUPABASE_SERVICE_ROLE_KEY=
# Job finder workflow (rotate: an old copy is in pushed git history).
ADZUNA_APP_KEY=

# ---------------------------------------------------------------------------
# scripts/render-n8n.mjs  (the n8n service on Render; automation/RENDER.md)
# `apply` writes N8N_BASE_URL back into the FIRST EXISTING env file; it never
# creates one.
RENDER_API_KEY=
# n8n's credential encryption key. Losing it orphans every stored credential.
N8N_ENCRYPTION_KEY=
# n8n's own database: the separate project isinzodyagsbqevpeure.
N8N_SUPABASE_REF=
N8N_DB_PASSWORD=

# ---------------------------------------------------------------------------
# video/scripts/voiceover.mjs  (VSL voice-over; video/SCENES.md)
ELEVENLABS_API_KEY=
# Optional; defaults to the narration voice in the script.
ELEVENLABS_VOICE_ID=

# ---------------------------------------------------------------------------
# CLIs the owner (or an agent, with permission) runs by hand. Not loaded by
# env.mjs; export them for the one command that needs them.
# wrangler: Worker deploys and `wrangler secret put`.
CLOUDFLARE_API_TOKEN=
# Account that will own the replacement keep-alive Worker.
CLOUDFLARE_ACCOUNT_ID=
# supabase CLI: `supabase db query --linked`, `functions deploy`, `secrets set`.
SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Site Worker secrets (nixgen-site). Production: `npx wrangler secret put <NAME>`
# from site/. Local dev reads them from site/.dev.vars, not from here; keep the
# copy here only so they can be re-set.
# Same value as the Vault secret 'lead_intake_secret' (034, 039).
LEAD_INTAKE_SECRET=
# Cloudflare Turnstile secret; optional until the widget renders.
TURNSTILE_SECRET_KEY=
# Salt for the hashed visitor network used by the intake throttle; required
# (unset → /api/contact and /api/subscribe answer 503).
LEAD_IP_SALT=
# HMAC key for the signed form render timestamp. The route works without it,
# but site/wrangler.jsonc requires it, so a deploy needs it on the Worker.
FORM_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# Supabase Edge Function secrets. Production: `supabase secrets set NAME=...`.
# Runbooks: supabase/README.md (table), PUSH.md, functions/*/README.md.
# `node scripts/setup-integrations.mjs` generates and saves VAPID_PUBLIC_KEY,
# VAPID_PRIVATE_KEY, VAPID_SUBJECT, GOOGLE_TOKEN_KEYS and GOOGLE_TOKEN_KEY_ID
# here, and reads GOOGLE_OAUTH_CLIENT_ID / _SECRET from here. Keep those lines:
# Supabase never shows a secret again, so this file is the only copy of the
# two keys. The two webhook secrets live in the Vault and are not stored here.
# Comma-separated origins allowed to call the functions (CORS allow-list).
APP_ORIGINS=
# google + google-calendar (keyring rules: functions/_shared/google_crypto.ts)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_TOKEN_KEYS=
GOOGLE_TOKEN_KEY_ID=
# The original single key; still read (as kid k0) to open older tokens.
GOOGLE_TOKEN_KEY=
GOOGLE_REDIRECT_BASE=
# Optional: the google function's own public URL when it is not the default.
GOOGLE_FUNCTION_URL=
# Same value as the Vault secret 'deskdev_google_calendar_secret' (040).
GOOGLE_CALENDAR_WEBHOOK_SECRET=
# send-push. Same value as the Vault secret 'deskdev_push_secret' (029).
PUSH_WEBHOOK_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# vault-reset: the n8n webhook that mails the approval code.
N8N_VAULT_RESET_WEBHOOK=

# ---------------------------------------------------------------------------
# Replacement n8n / Google Apps Script setup inputs (planned integration).
# These names reserve configuration for the upcoming setup; current runtime
# code does not consume them. Adding values alone does not connect Google.
# Google Cloud project ID, not its numeric project number.
GOOGLE_CLOUD_PROJECT_ID=
# Google account that will consent to the integrations; email address only.
GOOGLE_INTEGRATION_OWNER_EMAIL=
# n8n's OAuth client: authorize <N8N_BASE_URL>/rest/oauth2-credential/callback.
# May use the existing Google client if its redirect URIs include both n8n
# and DeskDev. Google sign-in is still required in n8n for each credential.
N8N_GOOGLE_OAUTH_CLIENT_ID=
N8N_GOOGLE_OAUTH_CLIENT_SECRET=
# Created during Apps Script setup; leave blank until the project is created.
GOOGLE_APPS_SCRIPT_ID=
GOOGLE_APPS_SCRIPT_WEB_APP_URL=
# Separate authentication key for a future signed Apps Script integration;
# generated during setup, never a Google password or an OAuth refresh token.
GOOGLE_APPS_SCRIPT_SHARED_SECRET=

# ---------------------------------------------------------------------------
# Company email setup inputs (planned outbound integration).
# Inbound: info@nixgensolutions.com -> nixgensolutions@gmail.com via Cloudflare
# Email Routing. The Gmail destination must be verified in its inbox first.
# Routing does not itself create a mailbox or an outbound SMTP credential.
# Outbound Cloudflare Email Sending requires a separately onboarded domain,
# an eligible account, and a token with Email Sending: Edit. Keep this token
# separate from the general deployment token. Current app code does not yet
# consume these setup inputs; setting them alone does not enable sending.
CLOUDFLARE_EMAIL_API_TOKEN=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_REPLY_TO_EMAIL=
# Cloudflare SMTP: smtp.mx.cloudflare.net, 465, true, username api_token.
# SMTP_PASSWORD is the restricted Email Sending API token, never Gmail's
# account password. Intended From and Reply-To: info@nixgensolutions.com.

# ---------------------------------------------------------------------------
# Keep-alive / watchdog Worker secrets (workers/n8n-keepalive/wrangler.jsonc).
# `npx wrangler secret put <NAME>` from that folder. Plain settings are `vars`
# in wrangler.jsonc, not secrets. N8N_WEBHOOK_SECRET above is shared.
SUPABASE_ANON_KEY=
# Optional fallback alert channel for when n8n itself is down.
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# ---------------------------------------------------------------------------
# GitHub Actions (repo Settings -> Secrets and variables -> Actions). Not
# read from any file; listed so the full set of names is in one place.
#   secrets: CLOUDFLARE_API_TOKEN (site-deploy), SUPABASE_BACKUP_DB_URL,
#            R2_BACKUP_ACCESS_KEY_ID, R2_BACKUP_SECRET_ACCESS_KEY,
#            N8N_WEBHOOK_SECRET (db-backup; docs/runbooks/BACKUP-RESTORE.md)
#   vars:    SITE_DEPLOY_ENABLED, DB_BACKUP_ENABLED, BACKUP_AGE_RECIPIENTS,
#            R2_ACCOUNT_ID, R2_BACKUP_BUCKET, N8N_ALERT_URL, and the public
#            NEXT_PUBLIC_* build values from site/.env.example
# scripts/backup/{backup,restore}.mjs read their names (BACKUP_DATABASE_URL,
# R2_*, AGE_BIN, ...) from the shell only, never from an env file.

# ---------------------------------------------------------------------------
# Retired: nothing in the repo reads these any more. Delete them from your
# .env.local (values first moved to a password manager where they are logins):
#   VITE_SUPABASE_URL VITE_SUPABASE_ANON_KEY            (the pre-merge web/ app)
#   N8N_FIND_WEBHOOK_SECRET N8N_APPROVED_WEBHOOK_URL N8N_ALERT_WEBHOOK_URL
#   N8N_MEDIA_WEBHOOK_URL DB_WEBHOOK_SECRET AUTOMATION_SHARED_SECRET
#   WEBHOOK_BASE_URL TEAM_EMAIL EMAIL_FROM GOOGLE_DRIVE_API_KEY GOOGLE_RELAY_SECRET
#   NEXT_PUBLIC_SITE_URL                               (belongs in site/.env.local)
#   RENDER_API_TOKEN                                   (old name; render-n8n.mjs still accepts it)
#   N8N_OWNER_EMAIL N8N_OWNER_PASSWORD DESKDEV_ADMIN_EMAIL DESKDEV_ADMIN_PASSWORD
#                                                      (logins: password manager)

    {
      "parameters": {
        "jsCode": "// Reached when Plan refused the email (no valid recipient) or Gmail did not\n// take it (the Gmail step continues on error, so its item carries `error`).\n// The row becomes 'failed' with a short reason the sender sees in DeskDev,\n// where Retry re-queues it (email_retry). Addresses never leave in the reason.\nconst plan = $('Plan').first().json;\nconst item = $input.first().json || {};\nconst raw = typeof item.error === 'string'\n  ? item.error\n  : (item.error && (item.error.message || item.error.description)) || (plan.action === 'fail' ? plan.reason : '') || 'Gmail did not accept the message';\nconst reason = String(raw)\n  .replace(/[^\\s@<>\"',;]+@[^\\s@<>\"',;]+/g, '[address]')\n  .replace(/[\\r\\n\\t]+/g, ' ')\n  .replace(/\\s{2,}/g, ' ')\n  .trim()\n  .slice(0, 500) || 'Gmail did not accept the message';\nreturn [{ json: { email_id: plan.email_id, error: reason } }];\n"
      },

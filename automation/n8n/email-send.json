        }
      },
      "notes": "Fired by migration 049: n8n_post('deskdev-email-send', { email_id }) when DeskDev queues an email, and again by email_retry for a failed one. The app never calls n8n."
    },
    {
      "parameters": {
        "jsCode": "// Called by the database, never by the app: migration 049's trigger runs\n// n8n_post('deskdev-email-send', { email_id }) when DeskDev queues an email\n// (email_retry posts the same for a failed one). Only the id travels; the row\n// is read back with the service role, so a forged body can at most name an\n// email that is already queued.\nconst body = $input.first().json.body || {};\nconst emailId = String(body.email_id || '').trim().toLowerCase();\nif (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test(emailId)) {\n  throw new Error('deskdev-email-send: body.email_id must be a uuid');\n}\nreturn [{ json: { email_id: emailId } }];\n"
      },
      "id": "parse",
      "name": "Parse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },

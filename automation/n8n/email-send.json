    {
      "parameters": {
        "jsCode": "// Decide everything once, so every later node reads the same facts.\r\n// Claim flipped the row queued → sending only if it was still queued: a\r\n// retried webhook, or a second run racing this one, finds nothing to claim\r\n// and stops here without sending. From a claim on, every path ends in 'sent'\r\n// or 'failed', never stuck in 'sending'.\r\nconst EMAIL_RE = /^[^\\s@,;<>\"']+@[^\\s@,;<>\"']+\\.[^\\s@,;<>\"']+$/;\r\n\r\nconst rows = (name) => $(name).all().map(i => i.json).flat().filter(r => r && typeof r === 'object');\r\nconst emailId = $('Parse').first().json.email_id;\r\nconst email = rows('Claim').find(r => r.id === emailId);\r\n// workspace_settings is a singleton keyed by id = true (migration 033).\r\nconst settings = rows('Settings').find(r => r.id === true) || {};\r\n\r\nif (!email) return [{ json: { action: 'skip', email_id: emailId, reason: 'not_queued' } }];\r\nconst fail = (reason) => [{ json: { action: 'fail', email_id: emailId, reason } }];\r\nif (email.direction !== 'out') return fail('not_outbound');\r\n\r\n// Every value below is teammate-typed text: escaped once, where it enters HTML.\r\nconst esc = (s) => String(s ?? '').replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\r\nconst oneLine = (s, max) => String(s ?? '').replace(/[\\r\\n\\t]+/g, ' ').replace(/\\s{2,}/g, ' ').trim().slice(0, max);\r\nconst lower = (a) => String(a || '').trim().toLowerCase();\r\n// Valid, at most 10, and each address once whatever its case (first spelling kept).\r\nconst addresses = (list) => {\r\n  const seen = new Map();\r\n  for (const a of (Array.isArray(list) ? list : []).map(x => String(x || '').trim())) {\r\n    if (EMAIL_RE.test(a) && !seen.has(lower(a))) seen.set(lower(a), a);\r\n  }\r\n  return [...seen.values()].slice(0, 10);\r\n};\r\n\r\nlet to = addresses(email.to_emails);\r\nlet cc = addresses(email.cc_emails).filter(a => !to.map(lower).includes(lower(a)));\r\nif (!to.length) return fail('no_valid_recipient');\r\n\r\n// Plain text in, simple HTML out: blank lines make paragraphs, single line\r\n// breaks stay line breaks. The signature (Settings → email) sits under a rule.\r\nconst paragraphs = (text) => String(text || '')\r\n  .replace(/\\r\\n?/g, '\\n')\r\n  .split(/\\n{2,}/)\r\n  .map(p => p.trim())\r\n  .filter(Boolean)\r\n  .map(p => `<p style=\"margin:0 0 14px\">${esc(p).replace(/\\n/g, '<br>')}</p>`)\r\n  .join('\\n');\r\nconst signature = String(settings.email_signature || '').trim().slice(0, 1000);\r\nconst html = `<div style=\"font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:#111;line-height:1.55;max-width:640px\">\r\n${paragraphs(String(email.body_text || '').slice(0, 50000))}\r\n${signature ? `<div style=\"margin-top:20px;padding-top:12px;border-top:1px solid #e5e7eb;color:#555;font-size:14px\">${esc(signature).replace(/\\r?\\n/g, '<br>')}</div>` : ''}\r\n</div>`;\r\n\r\n// A reply to a message the customer sent us goes back into their Gmail thread\r\n// (Gmail's reply operation, which answers the sender). Anyone else the\r\n// teammate addressed is copied. Follow-ups to our own mail, or replies whose\r\n// recipients no longer include the original sender, go out as new messages.\r\nconst original = rows('Original').find(r => r.id && r.id === email.in_reply_to);\r\nconst sender = original ? lower(original.from_email) : '';\r\nconst replyable = Boolean(original && original.direction === 'in' && original.gmail_message_id\r\n  && sender && to.map(lower).includes(sender));\r\nif (replyable) {\r\n  cc = [...new Set([...to.filter(a => lower(a) !== sender), ...cc])].slice(0, 10);\r\n  to = to.filter(a => lower(a) === sender);\r\n}\r\n\r\nconst fromAddress = String(settings.email_from_address || '').trim();\r\nreturn [{ json: {\r\n  action: 'send',\r\n  mode: replyable ? 'reply' : 'send',\r\n  email_id: emailId,\r\n  to: to.join(','),\r\n  cc: cc.join(','),\r\n  subject: oneLine(email.subject, 300) || '(no subject)',\r\n  html,\r\n  sender_name: oneLine(settings.email_from_name || 'NixGen Solutions', 80) || 'NixGen Solutions',\r\n  reply_to_gmail_id: replyable ? String(original.gmail_message_id) : null,\r\n  from_email: EMAIL_RE.test(fromAddress) ? fromAddress : null,\r\n} }];\r\n"
      },

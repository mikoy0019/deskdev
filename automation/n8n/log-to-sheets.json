    {
      "parameters": {
        "jsCode": "// Build one flat row per destination tab from the webhook payload.\n// A 'completed' activity is emitted twice: to Activity Log AND Task Completions.\nconst trig = $('Trigger').first().json;\nconst body = trig.body || trig;            // pg_net posts the JSON as the request body\nconst rec = body.record || {};\nconst table = body.table || '';\nconst actorRow = Array.isArray($json) ? $json[0] : $json;\nconst actorName = (actorRow && actorRow.full_name) || '';\n\nconst MNL = 'Asia/Manila';\nconst ts = rec.created_at || new Date().toISOString();\nconst d = new Date(ts);\nconst date = new Intl.DateTimeFormat('en-CA', { timeZone: MNL, year: 'numeric', month: '2-digit', day: '2-digit' }).format(d);\nconst time = new Intl.DateTimeFormat('en-GB', { timeZone: MNL, hour: '2-digit', minute: '2-digit', second: '2-digit' }).format(d);\nconst detail = rec.detail || {};\nconst title = detail.title || '';\n\n// Lead events: pipeline milestones only. Notes, submissions (the prospect's\n// message), email bodies and the every-5-minutes SLA rows stay in the database.\nconst SHEET_LEAD_ACTIONS = new Set(['created', 'stage_changed', 'contacted', 'won', 'lost', 'assigned',\n  'proposal_sent', 'converted', 'meeting_booked', 'booking_link_sent', 'call_logged', 'followup_set',\n  'auto_reply_sent', 'spam_marked', 'not_spam']);\nconst LEAD_DETAIL_DROP = new Set(['message', 'body', 'text', 'html', 'snippet', 'notes', 'note', 'email', 'phone', 'attribution', 'ip_hash', 'payload']);\nconst leadDetail = (d) => Object.fromEntries(Object.entries(d || {}).filter(([k]) => !LEAD_DETAIL_DROP.has(k)));\n\nconst out = [];\nif (table === 'task_activity') {\n  out.push({ json: {\n    _tab: 'Activity Log',\n    Timestamp: ts, Date: date, Time: time,\n    Action: rec.action || '', Task: title,\n    Actor: actorName, ActorId: rec.actor_id || '',\n    TaskId: rec.task_id || '', ClientId: rec.client_id || '',\n    Detail: JSON.stringify(detail),\n  } });\n  if (rec.action === 'completed') {\n    out.push({ json: {\n      _tab: 'Task Completions',\n      Timestamp: ts, Date: date, Time: time,\n      Task: title, CompletedBy: actorName,\n      TaskId: rec.task_id || '', ClientId: rec.client_id || '',\n    } });\n  }\n} else if (table === 'notifications') {\n  out.push({ json: {\n    _tab: 'Notifications',\n    Timestamp: ts, Date: date, Time: time,\n    Type: rec.type || '', Title: rec.title || '',\n    Actor: actorName, RecipientId: rec.user_id || '',\n    Entity: rec.entity || '', EntityId: rec.entity_id || '',\n  } });\n} else if (table === 'lead_activity' && SHEET_LEAD_ACTIONS.has(rec.action)) {\n  out.push({ json: {\n    _tab: 'Lead Activity',\n    Timestamp: ts, Date: date, Time: time,\n    Action: rec.action || '', Lead: detail.name || '',\n    Actor: actorName, ActorId: rec.actor_id || '',\n    LeadId: rec.lead_id || '',\n    Detail: JSON.stringify(leadDetail(detail)),\n  } });\n} else if (table === 'eod_reports') {\n  out.push({ json: {\n    _tab: 'EOD Reports',\n    Timestamp: ts, Date: date, Time: time,\n    Client: rec.client_id || '', ReportDate: rec.report_date || '',\n    Author: actorName, Minutes: rec.total_minutes || 0,\n    Content: rec.content || '',\n  } });\n}\nreturn out;\n"
      },

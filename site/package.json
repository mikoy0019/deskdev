{
  "name": "nixgen-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sw-source.mjs && node scripts/excalidraw-assets.mjs",
    "dev": "next dev --port 6969",
    "prebuild": "node scripts/showcase-snapshot.mjs && node scripts/sw-source.mjs && node scripts/excalidraw-assets.mjs",
    "build": "next build",
    "start": "next start --port 6969",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:preview": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env preview",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@opennextjs/cloudflare": "^1.20.8",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.38.0",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^29.1.1",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "type": "module",
  "overrides": {
    "fflate": "^0.7.5",
    "@opennextjs/cloudflare": {
      "@dotenvx/dotenvx": "^2.33.0"
    }
  }
}

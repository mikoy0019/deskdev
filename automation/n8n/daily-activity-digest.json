    {
      "id": "57e5184d-6953-4c06-80eb-beb7dd382d6c",
      "name": "Build Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "// Recipients come from profiles (the Recipients node), never a hardcoded\n// personal address: the mail follows whoever holds the role today, and a\n// deactivated account (profiles.deactivated_at, migration 032) stops getting\n// it. The company inbox is used only when nobody qualifies.\nconst FALLBACK_TO = 'nixgensolutions@gmail.com';\nconst EMAIL_RE = /^[^\\s@,;<>\"']+@[^\\s@,;<>\"']+\\.[^\\s@,;<>\"']+$/;\nconst people = $('Recipients').all().map(i => i.json).flat()\n  .filter(p => p && p.id && !p.deactivated_at && EMAIL_RE.test(String(p.email || '').trim()));\nconst can = (p, feature, level) => p.role === 'admin'\n  || (p.permissions || {})[feature] === 'edit'\n  || (level === 'view' && (p.permissions || {})[feature] === 'view');\nconst addressOf = (list) => [...new Set(list.map(p => String(p.email).trim().toLowerCase()))].join(',');\nconst TO = addressOf(people.filter(p => p.role === 'admin')) || FALLBACK_TO;\n\nconst done = $(\"Completed Today\").all().map(i=>i.json).flat().filter(t => t && t.title);\nconst hours = $(\"Hours Today\").all().map(i=>i.json).flat().filter(e => e && typeof e.minutes === 'number');\nconst totalMin = hours.reduce((s,e)=>s+(e.minutes||0),0);\nconst hm = m => `${Math.floor(m/60)}h ${m%60}m`;\nconst byUser = {};\nfor (const e of hours) { const u = e.user?.full_name||\"Unknown\"; byUser[u]=(byUser[u]||0)+e.minutes; }\nlet body = `DeskDev — daily activity, ${new Date().toLocaleDateString(\"en-PH\",{timeZone:\"Asia/Manila\"})}\\n\\n`;\nbody += `Tasks completed today: ${done.length}\\n`;\nbody += done.map(t=>`  • ${t.title} — ${t.client?.name||\"No client\"} (${t.assignee?.full_name||\"—\"})`).join(\"\\n\") || \"  (none)\";\nbody += `\\n\\nHours logged today: ${hm(totalMin)}\\n`;\nbody += Object.entries(byUser).sort((a,b)=>b[1]-a[1]).map(([k,v])=>`  • ${k}: ${hm(v)}`).join(\"\\n\") || \"  (none)\";\nbody += `\\n\\n— DeskDev Studio`;\nreturn [{ json: { to: TO, subject: `Daily activity — ${done.length} done, ${hm(totalMin)} logged`, body } }];\n"
      }
    },
    {
      "id": "d27e69d2-8724-44fb-9006-68af98fb31a5",
      "name": "Send Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1100,

          "id": "__SUPABASE_CRED__",
          "name": "Supabase — DeskDev"
        }
      },
      "notes": "Conditional claim: only a row still queued flips to sending and comes back. A retried webhook or a second run gets nothing and stops at Plan, so an email is never sent twice."
    },
    {
      "parameters": {
        "url": "=https://rgasjotvqwkjbeivlhvn.supabase.co/rest/v1/emails?select=id,direction,from_email,gmail_message_id&id=eq.{{ ($('Claim').all().map(i => i.json).flat().find(r => r && r.id === $('Parse').first().json.email_id) || {}).in_reply_to || '00000000-0000-0000-0000-000000000000' }}&limit=1",

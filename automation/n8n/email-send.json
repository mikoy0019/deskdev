      "parameters": {
        "method": "PATCH",
        "url": "=https://rgasjotvqwkjbeivlhvn.supabase.co/rest/v1/emails?id=eq.{{ $json.email_id }}&direction=eq.out&status=eq.queued&select=*",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
